<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{EEEA19A3-21FB-481F-9853-47DCE8AD3301}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>TraceStackCUm</RootNamespace>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="Exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)build\$(Configuration.ToLowerInvariant())\</OutDir>
    <IntDir>$(OutDir)obj\$(MSBuildProjectName)\</IntDir>
    <TargetName>trace-stack-c-um</TargetName>
    <LinkIncremental>false</LinkIncremental>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <WppKitsRoot Condition="'$(WppKitsRoot)' == ''">$(WindowsSdkDir)</WppKitsRoot>
    <WppConfigDir>$(WppKitsRoot)\bin\$(WindowsTargetPlatformVersion)\WppConfig\Rev1</WppConfigDir>
    <WppExe>$(WppKitsRoot)\bin\$(WindowsTargetPlatformVersion)\x64\tracewpp.exe</WppExe>
    <WppRecorderLib>$(WppKitsRoot)\Lib\$(WindowsTargetPlatformVersion)\um\x64\wpprecorderum.lib</WppRecorderLib>
    <CustomBuildBeforeTargets>ClCompile</CustomBuildBeforeTargets>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsC</CompileAs>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AssemblerOutput>AssemblyAndSourceCode</AssemblerOutput>
      <AssemblerListingLocation>$(OutDir)%(Filename).asm</AssemblerListingLocation>
      <ProgramDataBaseFileName>$(OutDir)compiler.pdb</ProgramDataBaseFileName>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <SupportJustMyCode>false</SupportJustMyCode>
      <FunctionLevelLinking>false</FunctionLevelLinking>
      <AdditionalIncludeDirectories>$(OutDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <Optimization Condition="'$(Configuration)' == 'Debug'">Disabled</Optimization>
      <InlineFunctionExpansion Condition="'$(Configuration)' == 'Debug'">Disabled</InlineFunctionExpansion>
      <Optimization Condition="'$(Configuration)' == 'Release'">MaxSpeed</Optimization>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <TargetMachine>MachineX64</TargetMachine>
      <GenerateDebugInformation>DebugFull</GenerateDebugInformation>
      <ProgramDatabaseFile>$(OutDir)$(TargetName).pdb</ProgramDatabaseFile>
      <GenerateMapFile>true</GenerateMapFile>
      <MapFileName>$(OutDir)$(TargetName).map</MapFileName>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>false</EnableCOMDATFolding>
      <AdditionalDependencies>advapi32.lib;ntdll.lib;$(WppRecorderLib);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.c" />
    <WppConfigInput Include="$(WppConfigDir)\*.ini;$(WppConfigDir)\*.tpl" />
    <CustomBuild Include="trace.h">
      <Message>Generating main.tmh with tracewpp</Message>
      <Command>"$(WppExe)" -um -NoHashChk "-cfgdir:$(WppConfigDir)" "-scan:$(ProjectDir)trace.h" "-odir:$(OutDir)." "$(ProjectDir)main.c"</Command>
      <AdditionalInputs>$(ProjectDir)main.c;$(MSBuildProjectFullPath);$(WppExe);@(WppConfigInput);%(AdditionalInputs)</AdditionalInputs>
      <Outputs>$(OutDir)main.tmh</Outputs>
      <LinkObjects>false</LinkObjects>
    </CustomBuild>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="ValidateWppConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64' or ('$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release')"
           Text="Only Debug|x64 and Release|x64 are supported." />
    <Error Condition="!Exists('$(WppExe)')"
           Text="tracewpp was not found at $(WppExe). Install the matching WDK or set WppKitsRoot and WindowsTargetPlatformVersion." />
    <Error Condition="!Exists('$(WppConfigDir)\defaultwpp.ini')"
           Text="WPP configuration is missing from $(WppConfigDir)." />
    <Error Condition="!Exists('$(WppRecorderLib)')"
           Text="The user-mode IFR library was not found at $(WppRecorderLib). Install the matching WDK or set WppKitsRoot and WindowsTargetPlatformVersion." />
  </Target>
</Project>
