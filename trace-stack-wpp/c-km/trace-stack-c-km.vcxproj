<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{96012240-27DC-49C2-A75F-F213D6B2E201}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>TraceStackCKm</RootNamespace>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="Exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)build\$(Configuration.ToLowerInvariant())\</OutDir>
    <IntDir>$(OutDir)obj\</IntDir>
    <TargetName>trace-stack-c-km</TargetName>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <WppKitsRoot Condition="'$(WppKitsRoot)' == ''">$(WindowsSdkDir)</WppKitsRoot>
    <WppConfigDir>$(WppKitsRoot)\bin\$(WindowsTargetPlatformVersion)\WppConfig\Rev1</WppConfigDir>
    <WppExe>$(WppKitsRoot)\bin\$(WindowsTargetPlatformVersion)\x64\tracewpp.exe</WppExe>
    <WdkKernelIncludeDir>$(WppKitsRoot)\Include\$(WindowsTargetPlatformVersion)\km</WdkKernelIncludeDir>
    <CustomBuildBeforeTargets>ClCompile</CustomBuildBeforeTargets>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsC</CompileAs>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <AssemblerOutput>AssemblyAndSourceCode</AssemblerOutput>
      <AssemblerListingLocation>$(OutDir)%(Filename).asm</AssemblerListingLocation>
      <ProgramDataBaseFileName>$(OutDir)compiler.pdb</ProgramDataBaseFileName>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <SupportJustMyCode>false</SupportJustMyCode>
      <FunctionLevelLinking>false</FunctionLevelLinking>
      <PreprocessorDefinitions>_AMD64_;WINNT;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(OutDir);$(WdkKernelIncludeDir);$(WppKitsRoot)\Include\$(WindowsTargetPlatformVersion)\shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions>/kernel %(AdditionalOptions)</AdditionalOptions>
      <Optimization Condition="'$(Configuration)' == 'Debug'">Disabled</Optimization>
      <InlineFunctionExpansion Condition="'$(Configuration)' == 'Debug'">Disabled</InlineFunctionExpansion>
      <Optimization Condition="'$(Configuration)' == 'Release'">MaxSpeed</Optimization>
    </ClCompile>
    <Lib>
      <TargetMachine>MachineX64</TargetMachine>
    </Lib>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.c" />
    <WppConfigInput Include="$(WppConfigDir)\*.ini;$(WppConfigDir)\*.tpl" />
    <CustomBuild Include="trace.h">
      <Message>Generating kernel-mode main.tmh with tracewpp</Message>
      <Command>"$(WppExe)" -km -NoHashChk "-cfgdir:$(WppConfigDir)" "-scan:$(ProjectDir)trace.h" "-odir:$(OutDir)." "$(ProjectDir)main.c"</Command>
      <AdditionalInputs>$(ProjectDir)main.c;$(MSBuildProjectFullPath);$(WppExe);@(WppConfigInput);%(AdditionalInputs)</AdditionalInputs>
      <Outputs>$(OutDir)main.tmh</Outputs>
      <LinkObjects>false</LinkObjects>
    </CustomBuild>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="ValidateWppConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64' or ('$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release')"
           Text="Only Debug|x64 and Release|x64 are supported." />
    <Error Condition="!Exists('$(WppExe)')"
           Text="tracewpp was not found at $(WppExe). Install the matching WDK or set WppKitsRoot and WindowsTargetPlatformVersion." />
    <Error Condition="!Exists('$(WppConfigDir)\defaultwpp.ini')"
           Text="WPP configuration is missing from $(WppConfigDir)." />
    <Error Condition="!Exists('$(WdkKernelIncludeDir)\ntddk.h')"
           Text="Kernel headers were not found at $(WdkKernelIncludeDir). Install the matching WDK or set WppKitsRoot and WindowsTargetPlatformVersion." />
  </Target>
</Project>
