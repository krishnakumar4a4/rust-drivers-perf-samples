;
; sample_kmdf_no_tracing.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
CatalogFile = sample_kmdf_no_tracing.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
sample_kmdf_no_tracing.sys  = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%sample_kmdf_no_tracing.DeviceDesc% = sample_kmdf_no_tracing_Device, Root\sample_kmdf_no_tracing ; TODO: edit hw-id

[sample_kmdf_no_tracing_Device.NT]
CopyFiles = File_Copy

[File_Copy]
sample_kmdf_no_tracing.sys

;-------------- Service installation
[sample_kmdf_no_tracing_Device.NT.Services]
AddService = sample_kmdf_no_tracing,%SPSVCINST_ASSOCSERVICE%, sample_kmdf_no_tracing_Service_Inst

; -------------- KMDF driver install sections
[sample_kmdf_no_tracing_Service_Inst]
DisplayName    = %sample_kmdf_no_tracing.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\sample_kmdf_no_tracing.sys

[sample_kmdf_no_tracing_Device.NT.Wdf]
KmdfService = sample_kmdf_no_tracing, sample_kmdf_no_tracing_wdfsect

[sample_kmdf_no_tracing_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "Rust for Drivers"
DiskName = "KMDF Installation Disk"
sample_kmdf_no_tracing.DeviceDesc = "Sample KMDF No-Tracing Device"
sample_kmdf_no_tracing.SVCDESC = "Sample KMDF No-Tracing Service"